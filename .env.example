# Ramat Chatbot — Environment Variables
# Copy this to .env.local and fill in values.

# ──────────────────────────────────────────────
# Database (Vercel Postgres / Neon)
# ──────────────────────────────────────────────
# Get this from your Vercel project → Storage → Postgres, or Neon console.
DATABASE_URL="postgresql://user:pass@host:5432/ramat?sslmode=require"

# ──────────────────────────────────────────────
# AI Provider — Longcat
# ──────────────────────────────────────────────
# Longcat API (OpenAI-compatible). Docs: https://longcat.ai/platform/docs/api-docs
# Base URL of the Longcat API
LONGCAT_BASE_URL="https://api.longcat.chat"
# Your Longcat API key (get from https://longcat.ai/platform/)
LONGCAT_API_KEY="your-longcat-api-key"
# Model id. LongCat-2.0 is the current model.
LONGCAT_MODEL="LongCat-2.0"

# ──────────────────────────────────────────────
# Admin Authentication
# ──────────────────────────────────────────────
# Comma-separated list of admin emails allowed to access /admin
ADMIN_EMAILS="admin@echosystems.ng"
# Set a strong random secret for signing auth cookies (openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-random-secret"

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
# Public URL of this bot deployment (used by the embed script)
NEXT_PUBLIC_APP_URL="https://ramat.echosystems.ng"
# Public Echo Systems website URL (used for links / context)
NEXT_PUBLIC_SITE_URL="https://echosystems.ng"
